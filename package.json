{
  "name": "anthroclaw",
  "version": "1.1.7",
  "description": "Claude Agent SDK-native control plane for personal multi-agent assistants",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "whatsapp:pair": "tsx src/cli/whatsapp-pair.ts",
    "build": "tsc && pnpm --filter \"@anthroclaw/plugin-*\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:check": "node scripts/release.mjs --check",
    "release:dry": "node scripts/release.mjs patch --dry-run",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "runtime:pi-decision": "node scripts/runtime-v1-decision-package.mjs",
    "runtime:pi-canary-agent": "tsx src/cli/pi-production-canary-agent.ts",
    "runtime:pi-monitor": "tsx src/cli/pi-monitor.ts",
    "runtime:pi-expansion-audit": "tsx src/cli/pi-expansion-audit.ts",
    "runtime:pi-expansion-packet": "tsx src/cli/pi-expansion-packet.ts",
    "runtime:pi-leads-agent-dry-run": "tsx src/cli/pi-leads-agent-dry-run.ts",
    "runtime:pi-content-sm-dry-run": "tsx src/cli/pi-content-sm-dry-run.ts",
    "reset-password": "tsx src/cli/reset-password.ts",
    "learning": "tsx src/cli/learning.ts",
    "headless:runtime": "tsx src/cli/headless-runtime.ts",
    "smoke:pi-auth": "tsx src/cli/pi-auth-smoke.ts",
    "smoke:pi-workspace": "tsx src/cli/pi-workspace-smoke.ts",
    "smoke:pi-gateway": "tsx src/cli/pi-gateway-smoke.ts",
    "smoke:pi-all": "tsx src/cli/pi-smoke-suite.ts",
    "smoke:pi-v1-canary": "tsx src/cli/pi-v1-canary.ts",
    "smoke:pi-sessions-memory": "tsx src/cli/pi-sessions-memory-canary.ts",
    "smoke:pi-plugins-context": "tsx src/cli/pi-plugins-context-canary.ts",
    "smoke:pi-external-mcp": "tsx src/cli/pi-external-mcp-canary.ts",
    "smoke:pi-dashboard-operator": "tsx src/cli/pi-dashboard-operator-canary.ts",
    "smoke:pi-scheduled-buildroom": "tsx src/cli/pi-scheduled-buildroom-canary.ts",
    "smoke:pi-public-escalation": "tsx src/cli/pi-public-escalation-canary.ts",
    "smoke:pi-rollback-runtime": "tsx src/cli/pi-rollback-mixed-runtime-canary.ts",
    "buildroom": "tsx src/cli/buildroom.ts",
    "plugins": "tsx src/cli/plugins.ts",
    "migrate:safety-profile": "tsx scripts/migrate-safety-profile.ts",
    "migrate:memory-candidates": "tsx scripts/backfill-memory-candidates.ts",
    "ui": "cd ui && pnpm dev",
    "ui:build": "cd ui && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.116",
    "@anthropic-ai/claude-code": "^2.1.140",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.42.0",
    "gray-matter": "^4.0.3",
    "openai": "^6.34.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "semver": "^7.7.4",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "better-sqlite3",
      "cpu-features",
      "esbuild",
      "ssh2"
    ]
  },
  "optionalDependencies": {
    "@earendil-works/pi-coding-agent": "0.74.0"
  }
}
