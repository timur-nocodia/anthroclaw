# ─── Claude / Anthropic auth ──────────────────────────────────────────
# Recommended: use Settings → Claude subscription auth in the admin UI.
# The UI stores Claude Code subscription auth in ./data/claude, mounted as
# /home/node/.claude inside the container.
#
# Optional CI / immutable deploy alternative:
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
#
# Optional Console API key (separate pay-as-you-go billing, not subscription):
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Channels ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ─── Optional providers ───────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here
BRAVE_API_KEY=your-brave-search-api-key-here
EXA_API_KEY=your-exa-api-key-here

# ─── Runtime ──────────────────────────────────────────────────────────
LOG_LEVEL=info
TZ=UTC
UI_PORT=3000

# ─── Capability cutoff (v0.8.0) ───────────────────────────────────────
# Canonical paths for the agents and data directories. Gateway.start()
# installs these from its actual startup arguments while running, then
# restores the previous process env on stop. Keep explicit values here for
# non-Gateway helper processes or immutable deploys where startup arguments
# are not the only source of truth.
OC_AGENTS_DIR=/app/agents
OC_DATA_DIR=/app/data

# Master key for the encrypted credential store
# (src/agent/credentials/encrypted-fs-store.ts). 32 bytes / 64 hex chars.
# Generate once with: openssl rand -hex 32
# REQUIRED once any agent uses the credential store (v0.9.0+); set now to
# avoid surprise at the v0.9 deploy.
ANTHROCLAW_MASTER_KEY=
